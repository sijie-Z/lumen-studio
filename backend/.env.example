# Local development: SQLite
DATABASE_URL=sqlite://photography.db?mode=rwc

# Production: PostgreSQL
# DATABASE_URL=postgres://app:secret@localhost:5432/photography

JWT_SECRET=change-this-to-a-long-random-secret
BIND_ADDR=127.0.0.1:8080
RUST_LOG=api=debug,tower_http=debug

# Comma-separated browser origins. Defaults to local Vite dev servers when unset.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Per-IP token bucket applied globally. Defaults: 20 requests/second, burst 40.
# Set RATE_LIMIT_ENABLED=false to disable in local experiments.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_SECOND=20
RATE_LIMIT_BURST=40
